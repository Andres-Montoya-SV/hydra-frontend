{
  "name": "hydra-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "vendor/hydra-ui"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run styles && next dev",
    "styles": "tailwindcss -i vendor/hydra-ui/src/styles.css -o vendor/hydra-ui/dist/styles.css --minify",
    "build": "npm run styles && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm test && npm run build && npm run typecheck"
  },
  "dependencies": {
    "@hydra-security/ui": "file:vendor/hydra-ui",
    "jose": "6.2.12",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
